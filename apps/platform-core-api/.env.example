NODE_ENV=development
PORT=4100
API_PREFIX=api/v1
FRONTEND_ORIGIN=http://127.0.0.1:4177
PANEL_ORIGIN_ROLES=http://127.0.0.1:4177=USER|ADMIN
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform_core_test
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
STORAGE_ROOT=
STORAGE_MAX_FILE_SIZE_BYTES=26214400
STORAGE_SIGNED_URL_TTL_SECONDS=300
# AI_PROVIDER options: deterministic (fake, no cost), openai (paid, needs billing), gemini (free tier available via aistudio.google.com)
AI_PROVIDER=deterministic
AI_API_KEY=
# gpt-4.1-mini for openai, gemini-3.6-flash for gemini (older gemini-2.5-flash is deprecated for new API keys)
AI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=30000
